# 1. Токен бота
BOT_TOKEN=

# 2. Telegram ID администраторов (через запятую, свой ID покажет /myid).
# Также можно добавлять через админ-панель.
ADMIN_IDS=

# 3. (необязательно) Telegram ID менеджеров (через запятую). Также можно добавить через админ-панель.
MANAGER_IDS=

# 4. (необязательно) чат для заявок. Проще: администратор пишет боту /setmanager
MANAGER_CHAT_ID=
